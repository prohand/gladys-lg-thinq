    {
      "key": "behaviour",
      "type": "section",
      "label": {
        "en": "Behaviour",
        "fr": "Comportement"
      },
      "description": {
        "en": "LG meters the number of API calls per client. Each appliance costs one call per refresh, so keep the interval comfortable if you own many appliances.",
        "fr": "LG limite le nombre d'appels d'API par client. Chaque appareil coûte un appel par rafraîchissement : gardez un intervalle confortable si vous possédez beaucoup d'appareils."
      }
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often each appliance is read, in seconds.",
        "fr": "Fréquence de lecture de chaque appareil, en secondes."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 3600
    },
    {
      "key": "temperature_unit",
      "type": "select",
      "label": {
        "en": "Temperature unit",
        "fr": "Unité de température"
      },
      "description": {
        "en": "LG publishes each temperature twice, in Celsius and in Fahrenheit. Only the chosen unit becomes a Gladys feature.",
        "fr": "LG publie chaque température deux fois, en Celsius et en Fahrenheit. Seule l'unité choisie devient une fonctionnalité Gladys."
      },
      "required": false,
      "default": "celsius",
      "options": [
        {
          "value": "celsius",
          "label": {
            "en": "Celsius",
            "fr": "Celsius"
          }
        },
        {
          "value": "fahrenheit",
          "label": {
